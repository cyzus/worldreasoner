# Environment variables for WorldReasoner
# Copy this file to .env and fill in your values

# Database
WORLDREASONER_DATABASE_PASSWORD=your_postgres_password

# API Keys (uncomment and fill in as needed)
# OPENAI_API_KEY=sk-...
# COHERE_API_KEY=...
# PINECONE_API_KEY=...
# GEMINI_API_KEY=...

# Redis (if using password)
# WORLDREASONER_REDIS_PASSWORD=your_redis_password

# Debug mode
WORLDREASONER_DEBUG=true
