# Environment variables for WorldReasoner
# Copy this file to .env and fill in your values

# API Keys (uncomment and fill in as needed)
# OPENAI_API_KEY=sk-...
# COHERE_API_KEY=...
# GEMINI_API_KEY=...

# Debug mode
WORLDREASONER_DEBUG=true
FRONTEND_PORT=5173

# Single source of truth for backend API server port (shared by backend + frontend proxy)
WORLDREASONER__SERVER__PORT=8300

# Optional frontend-only override for Vite proxy (normally leave unset)
# BACKEND_PORT=8300

# Database path (optional, defaults to worldreasoner.db in project root)
# WORLDREASONER__DATABASE__DB_PATH=/path/to/custom.db

# Use SearXNG for web searches (optional)
# SEARXNG_BASE_URL=http://127.0.0.1:xxxx